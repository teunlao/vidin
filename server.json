{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.teunlao/vidin",
  "description": "Turn a screen recording into annotated keyframes a coding agent can read. MCP server + CLI.",
  "repository": {
    "url": "https://github.com/teunlao/vidin",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@teunlao/vidin",
      "version": "0.1.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the MCP server on stdio"
        }
      ]
    }
  ]
}
