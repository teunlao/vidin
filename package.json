{
  "name": "vidin",
  "version": "0.1.0",
  "description": "Turn a video (bug report, screen recording) into an agent-readable set of annotated keyframes",
  "type": "module",
  "bin": {
    "vidin": "./bin/vidin.ts",
    "vidin-mcp": "./bin/vidin-mcp.ts"
  },
  "scripts": {
    "vidin": "bun run bin/vidin.ts",
    "mcp": "bun run bin/vidin-mcp.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "fixture": "bun run scripts/make-fixture.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "overrides": {
    "zod": "$zod"
  }
}
