{
  "name": "@teunlao/vidin",
  "version": "0.1.1",
  "description": "Turn a screen recording into annotated keyframes a coding agent can read. MCP server + CLI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teunlao/vidin.git"
  },
  "homepage": "https://github.com/teunlao/vidin#readme",
  "bugs": "https://github.com/teunlao/vidin/issues",
  "mcpName": "io.github.teunlao/vidin",
  "keywords": [
    "mcp",
    "mcp-server",
    "video",
    "screen-recording",
    "keyframes",
    "ffmpeg",
    "bug-report",
    "claude",
    "agent",
    "vision"
  ],
  "bin": {
    "vidin": "dist/bin/vidin.js",
    "vidin-mcp": "dist/bin/vidin-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "vidin": "bun run bin/vidin.ts",
    "mcp": "bun run bin/vidin-mcp.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "fixture": "bun run scripts/make-fixture.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zod": "$zod"
  },
  "publishConfig": {
    "access": "public"
  }
}
